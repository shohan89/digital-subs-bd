# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env, .env.local, .env.production(.local), .env.development(.local), .env.test, or
# anything else matching .env* is ignored. .env.example is the one deliberate exception: it holds
# only placeholders (see that file's own header) and is meant to be committed so the required
# variable list stays visible in the repo. Production secrets are never meant to live in a file at
# all — see CLOUDFLARE_DEPLOYMENT.md's "Environment variables" section; they're set via
# `wrangler secret put` / the Cloudflare dashboard, independent of this .gitignore rule.
.env*
!.env.example

# cloudflare
/.open-next/
/.wrangler/
.dev.vars
.dev.vars.*
cloudflare-env.d.ts

# supabase CLI local state
/supabase/.temp/
/supabase/.branches/

# vercel
.vercel

# Claude Code local session state (not project source)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
